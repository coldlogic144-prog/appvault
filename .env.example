# ComicLink Local Development Environment Configuration
# Configured for LOCAL FIREBASE EMULATOR development only.

# Enable Firebase Emulator connectivity
VITE_USE_EMULATORS=true

# Emulator Ports (matches backend/firebase.json)
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_STORAGE_PORT=9199
VITE_EMULATOR_FUNCTIONS_PORT=5001

# Local-only placeholder values required for Firebase Client SDK initialization.
# In emulator mode, these values are used only by the local Firebase client
# and are never sent to Google Cloud.
VITE_FIREBASE_API_KEY=local-emulator-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=comiclink-dev
VITE_FIREBASE_STORAGE_BUCKET=comiclink-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:localemulator
