rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isValidContentType() {
      return request.resource.contentType.matches('image/.*') 
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('text/.*')
          || request.resource.contentType.matches('application/zip')
          || request.resource.contentType.matches('application/x-zip-compressed')
          || request.resource.contentType.matches('application/json')
          || request.resource.contentType.matches('application/octet-stream');
    }
    function isLessThanMB(sizeMB) {
      return request.resource.size < sizeMB * 1024 * 1024;
    }

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Inter-Station File Transfers (Phase 4)
    match /transfers/{senderUid}/{recipientUid}/{fileId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == senderUid || request.auth.uid == recipientUid);
      allow write: if isAuthenticated() 
                   && request.auth.uid == senderUid 
                   && isLessThanMB(100) 
                   && isValidContentType();
    }

    // User Avatars
    match /users/{uid}/avatar/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) && isImage() && isLessThanMB(5);
    }

    // User Files
    match /users/{uid}/files/{fileId}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidContentType() && isLessThanMB(100);
    }

    // User Posts Media
    match /users/{uid}/posts/{postId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) && isImage() && isLessThanMB(10);
    }
  }
}
