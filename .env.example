# =============================================================================
# ComicLink Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to Git.
# =============================================================================

# Firebase Client Config (safe to embed in client — protected by security rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (optional, Phase 7)
# VITE_RECAPTCHA_SITE_KEY=

# Development flags
VITE_USE_EMULATORS=true
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_STORAGE_PORT=9199
VITE_EMULATOR_FUNCTIONS_PORT=5001
