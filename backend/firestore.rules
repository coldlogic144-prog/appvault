rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function isConversationMember(conversationId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids.hasAny([request.auth.uid]);
    }
    function isServerTimestamp(value) {
      return value == request.time;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. Private User Account: users/{uid}
    // ==========================================
    match /users/{uid} {
      // Owner only: get allowed for self, list/queries denied
      allow get: if isOwner(uid);
      allow list: if false;

      // Create: Owner-only, validates uid, role, accountStatus, initial counters, and strict field keys
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.accountStatus == 'active'
                    && request.resource.data.deviceCount == 0
                    && request.resource.data.email is string
                    && request.resource.data.emailVerified is bool
                    && request.resource.data.blockedUsers is list
                    && request.resource.data.clipboardSyncEnabled is bool
                    && request.resource.data.keys().hasAll(['uid', 'email', 'emailVerified', 'blockedUsers', 'clipboardSyncEnabled', 'deviceCount', 'role', 'accountStatus', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'emailVerified', 'blockedUsers', 'clipboardSyncEnabled', 'deviceCount', 'role', 'accountStatus', 'createdAt', 'updatedAt']);

      // Update: Owner-only, strictly limits client mutable fields to clipboardSyncEnabled, blockedUsers, updatedAt.
      // All server-managed and identity fields must remain identical to resource.data.
      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clipboardSyncEnabled', 'blockedUsers', 'updatedAt'])
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.accountStatus == resource.data.accountStatus
                    && request.resource.data.deviceCount == resource.data.deviceCount
                    && request.resource.data.emailVerified == resource.data.emailVerified
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.blockedUsers is list
                    && request.resource.data.clipboardSyncEnabled is bool;

      // Direct client deletion is forbidden (managed via Cloud Functions)
      allow delete: if false;

      // User Devices Subcollection: users/{uid}/devices/{deviceId}
      match /devices/{deviceId} {
        allow get, list: if isOwner(uid);

        allow create: if isOwner(uid)
                      && request.resource.data.deviceId == deviceId
                      && request.resource.data.ownerId == uid
                      && request.resource.data.deviceName is string
                      && request.resource.data.deviceName.size() > 0
                      && request.resource.data.deviceName.size() <= 100
                      && request.resource.data.platform in ['windows', 'android', 'web']
                      && request.resource.data.appVersion is string
                      && request.resource.data.isRevoked == false
                      && request.resource.data.revokedAt == null
                      && request.resource.data.keys().hasAll(['deviceId', 'ownerId', 'deviceName', 'platform', 'appVersion', 'createdAt', 'lastSeenAt', 'isRevoked', 'revokedAt'])
                      && request.resource.data.keys().hasOnly(['deviceId', 'ownerId', 'deviceName', 'platform', 'appVersion', 'createdAt', 'lastSeenAt', 'isRevoked', 'revokedAt']);

        allow update: if isOwner(uid)
                      && request.resource.data.deviceId == resource.data.deviceId
                      && request.resource.data.ownerId == resource.data.ownerId
                      && request.resource.data.platform == resource.data.platform
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceName', 'lastSeenAt', 'isRevoked', 'revokedAt', 'appVersion'])
                      && (request.resource.data.isRevoked == resource.data.isRevoked || request.resource.data.isRevoked == true)
                      && (request.resource.data.deviceName is string && request.resource.data.deviceName.size() > 0 && request.resource.data.deviceName.size() <= 100);

        allow delete: if false; // Deletion blocked, soft-delete via revocation
      }
    }

    // ==========================================
    // 2. Public Presentation Profiles: publicProfiles/{uid}
    // ==========================================
    match /publicProfiles/{uid} {
      // Authenticated members can read public profile presentation cards
      allow read: if isAuthenticated();

      // Create: Owner-only, validates uid, presenceStatus, string lengths, and prevents field injection
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 50
                    && (request.resource.data.bio == null || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500))
                    && (request.resource.data.presenceStatus in ['online', 'offline', 'away'])
                    && request.resource.data.keys().hasAll(['uid', 'displayName', 'presenceStatus', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'bio', 'presenceStatus', 'updatedAt']);

      // Update: Owner-only, limits updates to presentation fields, enforces string lengths and presence enum
      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'presenceStatus', 'updatedAt'])
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 50
                    && (request.resource.data.bio == null || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500))
                    && (request.resource.data.presenceStatus in ['online', 'offline', 'away']);

      // Deletion is server-controlled
      allow delete: if false;
    }

    function isDeviceActive(uid, devId) {
      return devId is string
             && exists(/databases/$(database)/documents/users/$(uid)/devices/$(devId))
             && get(/databases/$(database)/documents/users/$(uid)/devices/$(devId)).data.isRevoked == false;
    }

    // ==========================================
    // 3. Pairing Sessions: pairingSessions/{sessionId}
    // ==========================================
    match /pairingSessions/{sessionId} {
      // Direct get allowed for involved parties or targets inspecting a pending invite
      allow get: if isAuthenticated() && (
        resource.data.initiatorUserId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        resource.data.status == 'pending'
      );

      // List queries strictly forbidden to prevent network session enumeration
      allow list: if false;

      // Creation by authenticated initiator for an active, unrevoked device
      allow create: if isAuthenticated()
                    && request.resource.data.sessionId == sessionId
                    && request.resource.data.initiatorUserId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.targetUserId == null
                    && request.resource.data.targetDeviceId == null
                    && request.resource.data.targetDeviceName == null
                    && request.resource.data.approvedAt == null
                    && request.resource.data.completedAt == null
                    && request.resource.data.cancelledAt == null
                    && request.resource.data.rejectedAt == null
                    && request.resource.data.pairingCode is string
                    && request.resource.data.pairingCode.size() >= 6
                    && request.resource.data.pairingCode.size() <= 16
                    && request.resource.data.challengeHash is string
                    && request.resource.data.challengeHash.size() >= 16
                    && request.resource.data.challengeHash.size() <= 128
                    && request.resource.data.initiatorDeviceName is string
                    && request.resource.data.initiatorDeviceName.size() > 0
                    && request.resource.data.initiatorDeviceName.size() <= 100
                    && request.resource.data.initiatorDeviceId is string
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.resource.data.createdAt
                    && isDeviceActive(request.auth.uid, request.resource.data.initiatorDeviceId)
                    && request.resource.data.keys().hasAll(['sessionId', 'initiatorUserId', 'initiatorDeviceId', 'initiatorDeviceName', 'pairingCode', 'status', 'targetUserId', 'targetDeviceId', 'targetDeviceName', 'challengeHash', 'createdAt', 'expiresAt', 'approvedAt', 'completedAt', 'cancelledAt', 'rejectedAt'])
                    && request.resource.data.keys().hasOnly(['sessionId', 'initiatorUserId', 'initiatorDeviceId', 'initiatorDeviceName', 'pairingCode', 'status', 'targetUserId', 'targetDeviceId', 'targetDeviceName', 'challengeHash', 'createdAt', 'expiresAt', 'approvedAt', 'completedAt', 'cancelledAt', 'rejectedAt']);

      // Status transitions: strictly validated one-way transitions
      allow update: if isAuthenticated()
                    && request.resource.data.sessionId == resource.data.sessionId
                    && request.resource.data.initiatorUserId == resource.data.initiatorUserId
                    && request.resource.data.initiatorDeviceId == resource.data.initiatorDeviceId
                    && request.resource.data.challengeHash == resource.data.challengeHash
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && (
                      // 1. Initiator cancels pending session
                      (resource.data.status == 'pending'
                        && request.resource.data.status == 'cancelled'
                        && request.auth.uid == resource.data.initiatorUserId
                        && request.resource.data.cancelledAt is timestamp
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']))
                      ||
                      // 2. Target approves pending session before expiration
                      (resource.data.status == 'pending'
                        && request.resource.data.status == 'approved'
                        && request.time < resource.data.expiresAt
                        && request.resource.data.targetUserId == request.auth.uid
                        && request.resource.data.targetDeviceId != resource.data.initiatorDeviceId
                        && request.resource.data.targetDeviceName is string
                        && request.resource.data.targetDeviceName.size() > 0
                        && request.resource.data.targetDeviceName.size() <= 100
                        && request.resource.data.approvedAt is timestamp
                        && isDeviceActive(request.auth.uid, request.resource.data.targetDeviceId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'targetUserId', 'targetDeviceId', 'targetDeviceName', 'approvedAt']))
                      ||
                      // 3. Target rejects pending session
                      (resource.data.status == 'pending'
                        && request.resource.data.status == 'rejected'
                        && request.resource.data.targetUserId == request.auth.uid
                        && request.resource.data.rejectedAt is timestamp
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'targetUserId', 'rejectedAt']))
                      ||
                      // 4. Initiator finalizes approved session
                      (resource.data.status == 'approved'
                        && request.resource.data.status == 'completed'
                        && request.auth.uid == resource.data.initiatorUserId
                        && request.resource.data.completedAt is timestamp
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']))
                    );

      // Deletion is prohibited
      allow delete: if false;
    }

    // Pairing Code Index (Single doc lookup by code, list enumeration blocked)
    match /pairingCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated()
                    && request.resource.data.code == code
                    && request.resource.data.sessionId is string
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // ==========================================
    // 4. Paired Devices: pairedDevices/{pairId}
    // ==========================================
    match /pairedDevices/{pairId} {
      allow get, list: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.userA == request.auth.uid ||
        resource.data.userB == request.auth.uid
      );

      allow create: if isAuthenticated()
                    && (request.resource.data.ownerUid == request.auth.uid || request.resource.data.userA == request.auth.uid)
                    && request.resource.data.status == 'active'
                    && request.resource.data.createdAt is timestamp;

      allow update: if isAuthenticated()
                    && (resource.data.ownerUid == request.auth.uid || resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'unpairedAt'])
                    && request.resource.data.status == 'unpaired'
                    && request.resource.data.unpairedAt is timestamp;

      allow delete: if false;
    }

    // ==========================================
    // 5. Inter-Station File Transfers: files/{fileId}
    // ==========================================
    match /files/{fileId} {
      // Read: Single document get allowed for sender or recipient
      allow get: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );

      // List queries: Allowed for authenticated users filtering by their own role
      allow list: if isAuthenticated();

      // Create: Authenticated sender, valid registered active device, valid fields and limits
      allow create: if isAuthenticated()
                    && request.resource.data.fileId == fileId
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.recipientId is string
                    && request.resource.data.recipientId.size() > 0
                    && request.resource.data.sourceDeviceId is string
                    && isDeviceActive(request.auth.uid, request.resource.data.sourceDeviceId)
                    && request.resource.data.sourceDeviceName is string
                    && request.resource.data.sourceDeviceName.size() > 0
                    && request.resource.data.sourceDeviceName.size() <= 100
                    && request.resource.data.targetDeviceId is string
                    && request.resource.data.targetDeviceId.size() > 0
                    && request.resource.data.targetDeviceId.size() <= 100
                    && request.resource.data.targetDeviceName is string
                    && request.resource.data.targetDeviceName.size() > 0
                    && request.resource.data.targetDeviceName.size() <= 100
                    && request.resource.data.fileName is string
                    && request.resource.data.fileName.size() > 0
                    && request.resource.data.fileName.size() <= 255
                    && request.resource.data.fileSize is number
                    && request.resource.data.fileSize > 0
                    && request.resource.data.fileSize <= 100 * 1024 * 1024
                    && request.resource.data.mimeType is string
                    && request.resource.data.checksum is string
                    && request.resource.data.checksum.size() == 64
                    && request.resource.data.status in ['pending', 'uploading']
                    && request.resource.data.storagePath is string
                    && request.resource.data.failureReason == null
                    && request.resource.data.completedAt == null
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.resource.data.createdAt
                    && request.resource.data.keys().hasAll(['fileId', 'senderId', 'recipientId', 'sourceDeviceId', 'sourceDeviceName', 'targetDeviceId', 'targetDeviceName', 'fileName', 'mimeType', 'fileSize', 'storagePath', 'status', 'checksum', 'failureReason', 'createdAt', 'updatedAt', 'completedAt', 'expiresAt'])
                    && request.resource.data.keys().hasOnly(['fileId', 'senderId', 'recipientId', 'sourceDeviceId', 'sourceDeviceName', 'targetDeviceId', 'targetDeviceName', 'fileName', 'mimeType', 'fileSize', 'storagePath', 'status', 'checksum', 'failureReason', 'createdAt', 'updatedAt', 'completedAt', 'expiresAt']);

      // Update: Guarded state transitions and immutability of transport payload metadata
      allow update: if isAuthenticated()
                    && request.resource.data.fileId == resource.data.fileId
                    && request.resource.data.senderId == resource.data.senderId
                    && request.resource.data.recipientId == resource.data.recipientId
                    && request.resource.data.sourceDeviceId == resource.data.sourceDeviceId
                    && request.resource.data.sourceDeviceName == resource.data.sourceDeviceName
                    && request.resource.data.targetDeviceId == resource.data.targetDeviceId
                    && request.resource.data.targetDeviceName == resource.data.targetDeviceName
                    && request.resource.data.fileName == resource.data.fileName
                    && request.resource.data.mimeType == resource.data.mimeType
                    && request.resource.data.fileSize == resource.data.fileSize
                    && request.resource.data.storagePath == resource.data.storagePath
                    && request.resource.data.checksum == resource.data.checksum
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && request.resource.data.updatedAt is timestamp
                    && (
                      // 1. Sender transitions: pending -> uploading -> ready, or cancellation/failure
                      (request.auth.uid == resource.data.senderId
                        && resource.data.status in ['pending', 'uploading']
                        && request.resource.data.status in ['uploading', 'ready', 'failed', 'cancelled']
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'failureReason']))
                      ||
                      // 2. Recipient transitions: ready -> completed (with completedAt) or rejected
                      (request.auth.uid == resource.data.recipientId
                        && resource.data.status == 'ready'
                        && (
                          (request.resource.data.status == 'completed'
                            && request.resource.data.completedAt is timestamp
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'completedAt']))
                          ||
                          (request.resource.data.status in ['rejected', 'failed']
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'failureReason']))
                        ))
                    );

      // Deletion is blocked (soft-delete via status transitions)
      allow delete: if false;
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && resource.data.memberUids.hasAny([request.auth.uid]);
      allow create: if isAuthenticated() 
                    && request.resource.data.memberUids.hasAny([request.auth.uid])
                    && isServerTimestamp(request.resource.data.createdAt);
      allow update: if isAuthenticated() 
                    && resource.data.memberUids.hasAny([request.auth.uid]);
      
      // Conversation Members
      match /members/{uid} {
        allow read: if isConversationMember(conversationId);
        allow write: if isOwner(uid) && isConversationMember(conversationId);
      }

      // Conversation Messages
      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
                      && isOwner(request.resource.data.senderId)
                      && isServerTimestamp(request.resource.data.createdAt);
        allow update: if isConversationMember(conversationId)
                      && isOwner(resource.data.senderId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'edited', 'editedAt']);
        allow delete: if false; // Soft delete only
      }
    }

    // Clipboard Items
    match /clipboardItems/{clipboardId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId)
                    && isServerTimestamp(request.resource.data.createdAt);
      allow update: if isOwner(resource.data.ownerId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt']);
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if isAuthenticated() && (resource.data.visibility == 'public' || isOwner(resource.data.authorId));
      allow create: if isOwner(request.resource.data.authorId)
                    && isServerTimestamp(request.resource.data.createdAt);
      allow update: if isOwner(resource.data.authorId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'visibility', 'updatedAt']);
      allow delete: if false; // Soft delete or function only

      // Post Comments
      match /comments/{commentId} {
        allow read: if isAuthenticated(); // Assuming public posts, access check could be more robust
        allow create: if isOwner(request.resource.data.authorId)
                      && isServerTimestamp(request.resource.data.createdAt);
        allow update: if isOwner(resource.data.authorId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt']);
        allow delete: if false; // Soft delete
      }

      // Post Likes
      match /likes/{uid} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(uid);
      }
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read: if isOwner(resource.data.reporterId);
      allow create: if isOwner(request.resource.data.reporterId)
                    && isServerTimestamp(request.resource.data.createdAt);
      allow update, delete: if false; // Moderators/Functions only
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.recipientId);
      allow create, delete: if false; // Functions only
      allow update: if isOwner(resource.data.recipientId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }

    // Audit Logs (Cloud Functions only)
    match /auditLogs/{logId} {
      allow read, write: if false;
    }
  }
}
