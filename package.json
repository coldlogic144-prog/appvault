{
  "name": "comiclink",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-device communication and file-sharing platform with a comic-inspired UI",
  "workspaces": [
    "packages/*",
    "apps/windows",
    "backend/functions"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "node --test tests/unit/*.test.mjs tests/security-rules/rules.test.mjs tests/security-rules/emulator-auth.test.mjs",
    "test:rules": "firebase --config backend/firebase.json emulators:exec --only firestore \"scripts\\test-rules.cmd\"",
    "dev": "scripts\\dev.cmd",
    "emulators": "scripts\\emulators.cmd",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "clean": "rimraf **/dist **/node_modules/.cache"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^13.29.0"
  }
}
